{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "Live player statistics website and JSON API for Fabric servers. A fork of mc-stats-webui by borrageiros (${original_homepage}).",
	"authors": [
		"NR137",
		"borrageiros (original author of mc-stats-webui)"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_homepage}",
		"issues": "${mod_homepage}/issues"
	},
	"license": "${license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"webui.stats.mc.fabric.McStatsWebuiFabric"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
