		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@daidr/minecraft-skin-renderer": "^0.3.3",
		"@fontsource/jacquard-12": "^5.3.0",
		"@fontsource/press-start-2p": "^5.3.0",
